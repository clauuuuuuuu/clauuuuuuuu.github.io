---
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/config";

const cvFilePath = "/cv.pdf";
---

<Layout title={`cv | ${SITE.title}`}>
  <Header />
  <Main pageTitle="cv" pageDesc="curriculum vitae">
    <div class="space-y-4">
      <a
        href={cvFilePath}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block border-b-2 border-dashed border-foreground text-xl font-semibold hover:border-accent hover:text-accent"
      >
        download my CV (PDF)
      </a>

      <div class="overflow-hidden rounded-lg border border-border">
        <iframe
          src={cvFilePath}
          title="CV PDF preview"
          class="h-225 w-full"
        ></iframe>
      </div>
    </div>
  </Main>
  <Footer />
</Layout>
