---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";

import { SOCIALS } from "@/constants";
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index" class="app-layout">
    <section id="hero" class="pt-8 pb-6">

      <p class="mb-4">
        hi my name is chan shu ying claudia, welcome to my page :DD
      </p>
      <p class="mb-4">
        i'm currently a year 1 msc in research medicine student at the chinese
        university of hong kong (cuhk), taking a gap year
        between year 3 and 4 of medical studies to focus on my two main
        research projects: cancercompanion and rheumavision.
      </p>
      <p class="mb-4">
        my research interests include medical imaging, deep learning and
        developing patient-facing products.
      </p>
      <p class="mb-4">
        i also really enjoy taking photos (i have like 6 cameras of 3 different
        formats) and am a semi-active r&d member at the cuhk robotics team.
      </p>
      <p class="mb-4">
        always happy to collaborate / get to know different ppl :) feel free to
        message me on linkedin / email me
      </p>
      {
        SOCIALS.length > 0 && (
          <div class="mt-4 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">links:</div>
            <Socials />
          </div>
        )
      }
    </section>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
