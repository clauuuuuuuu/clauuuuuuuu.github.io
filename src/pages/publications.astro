---
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/config";

const publications = [
  {
    title: "Beyond Bounding Boxes: Keypoint-Based Deep Learning for Automated Joint Localization in Radiographic Scoring of Rheumatoid Arthritis",
    authors: "Chan S, Leung Y, Meng H, Jin Y, So H, Tam L",
    venue: "International Conference of Chinese Rheumatologists, 2026",
    links: [{ label: "", href: "#" }],
  },
  {
    title:
      "Automating Radiographic Damage Assessment in Rheumatoid Arthritis: A Narrative Review of Current Status and Future Perspectives",
    authors:
      "Meng, H., Jin, Y., <strong>Chan, S. Y.</strong>, Leung, Y.-M., Tam, L.-S., & So, H. (",
    venue: "Journal of Clinical Rheumatology and Immunology, 2025",
    links: [
      { label: "paper", href: "https://doi.org/10.1142/s2661341725300034"},
    ],
  },
];

const patents = [
  {
    title:
      "AN AI-POWERED CONVERSATIONAL SYSTEM FOR ADAPTIVE, CANCER-AWARE EMOTIONAL SUPPORT WITH STRUCTURED THERAPEUTIC FRAMEWORK",
    inventors:
      "Li Man Ho Tim, <strong>Shu Ying Chan</strong>, Yau-ming Leung, Tsang Wing Cheong",
    status: "US provisional patent, 2026",
    links: [{ label: "", href: "" }],
  },
  {
    title: "A SYSTEM AND METHOD FOR ASSESSING A CONDITION OF A JOINT",
    inventors:
      "Lai-shan Tam, <strong>Shu Ying Chan</strong>, Yau-ming Leung, Ho So, Huan Meng, Yingzhao Jin",
    status: "US provisional patent, 2026",
    links: [{ label: "", href: "" }],
  },
];
---

<Layout title={`publications & patents | ${SITE.title}`}>
  <Header />
  <Main
    pageTitle="publications & patents"
    pageDesc="papers, preprints, and patents"
  >
    <section>
      <h2 class="text-xl font-semibold tracking-wide">publications</h2>
      <ul>
        {
          publications.map(pub => (
            <li class="py-4">
              <h3 class="text-lg font-semibold">{pub.title}</h3>
              <p class="mt-2" set:html={pub.authors} />
              <p class="mt-1 text-sm italic opacity-80">{pub.venue}</p>
              <div class="mt-3 flex flex-wrap gap-3">
                {pub.links.map(link => (
                  <a
                    href={link.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="border-b border-dashed border-foreground hover:border-accent hover:text-accent"
                  >
                    {link.label}
                  </a>
                ))}
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-semibold tracking-wide">patents</h2>
      <ul>
        {
          patents.map(patent => (
            <li class="py-4">
              <h3 class="text-lg font-semibold">{patent.title}</h3>
              <p class="mt-2" set:html={patent.inventors} />
              <p class="mt-1 text-sm italic opacity-80">{patent.status}</p>
              <div class="mt-3 flex flex-wrap gap-3">
                {patent.links.map(link => (
                  <a
                    href={link.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="border-b border-dashed border-foreground hover:border-accent hover:text-accent"
                  >
                    {link.label}
                  </a>
                ))}
              </div>
            </li>
          ))
        }
      </ul>
    </section>
  </Main>
  <Footer />
</Layout>
